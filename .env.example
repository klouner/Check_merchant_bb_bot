# Скопируй в .env и заполни. .env в .gitignore и в репозиторий не попадает.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAA-your-token-here

# ID чата для служебных уведомлений: новые пользователи, кто добавил/удалил мерчанта,
# Bybit API не отвечает. Пусто — не отправлять. Для группы ID начинается с -100.
ADMIN_GROUP_ID=

# Контакт для вопросов, показывается в /start и /help (например, @your_username). Пусто — не показывать.
ADMIN_CONTACT=

# Секунд между опросами Bybit (минимум 3)
CHECK_INTERVAL=10

# Папка для базы merchants.db и лога bot.log. По умолчанию — папка с кодом.
# В Docker задаётся в docker-compose.yml (/app/data), здесь не трогай.
# DATA_DIR=
